// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderCompletedJobs output > renders a filter miss 1`] = `
"
      <div class="empty-substate empty-queue-clean">
        <div class="clean-check-icon">⌕</div>
        <div class="clean-text font-mono">NO HISTORY MATCHES FILTER</div>
        <div class="clean-subtext">Try a different history filter. Current query: "&lt;nomatch&gt;".</div>
      </div>
    "
`;

exports[`renderCompletedJobs output > renders the empty history 1`] = `
"
      <div class="empty-substate empty-queue-clean">
        <div class="clean-check-icon">✓</div>
        <div class="clean-text font-mono">NO COMPLETED JOBS YET</div>
        <div class="clean-subtext">Recent successful and failed GitHub Actions jobs appear here with a quick retry path.</div>
      </div>
    "
`;

exports[`renderCompletedJobs output > renders the full history as cards and table rows > cards 1`] = `
"
        <article class="glass-panel" style="padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.7rem; border-left: 3px solid var(--emerald);">
