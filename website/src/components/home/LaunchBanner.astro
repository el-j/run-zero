---
// LaunchBanner: Bottom call to action banner
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="launch-banner">
  <div class="banner-inner">
    <h2>DEPLOY LOCAL RUNNER FLEET NOW</h2>
    <p>
      Initialize your workstation fleet in less than 60 seconds with our
      interactive configuration wizard.
    </p>
    <div class="banner-actions">
      <a href="#quickstart" class="btn-crimson">⚡ QUICKSTART NOW</a>
      <a href={`${baseUrl}/docs/`} class="btn-ghost">BROWSE DOCUMENTATION →</a>
    </div>
  </div>
</section>

<style>
  .launch-banner {
    padding: 60px 0 96px;
  }
  .banner-inner {
    background: linear-gradient(
      135deg,
      rgba(255, 51, 85, 0.08) 0%,
      rgba(16, 21, 34, 0.9) 100%
    );
    border: 1px solid var(--border-crimson);
    border-radius: var(--radius-lg);
    padding: 48px 32px;
    text-align: center;
    box-shadow:
      0 20px 50px -10px rgba(0, 0, 0, 0.8),
      0 0 30px -10px var(--crimson-dim);
  }
  .banner-inner h2 {
    font-size: 2.2rem;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .banner-inner p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 28px;
  }
  .banner-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
