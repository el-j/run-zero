---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import CodeShowcase from '../components/CodeShowcase.astro';
import ComparisonTable from '../components/ComparisonTable.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="RunZero ⚡ Zero Cloud Minutes. Zero K8s Bloat. Zero Idle Waste." currentPath="/">
  <div class="ambient-crimson"></div>
  <div class="ambient-solar"></div>

  <div class="container">
    
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-telemetry-badge">
        <span class="telemetry-dot"></span>
        <span class="telemetry-text">ARCHITECTURE // DUAL-ENGINE HYBRID CI</span>
        <span class="telemetry-pill">v0.0.1</span>
      </div>

      <h1 class="hero-title">
        Zero Cloud Minutes.<br />
        Zero K8s Bloat.<br />
        <span class="crimson-gradient">Zero Idle Waste.</span>
      </h1>

      <p class="hero-lead">
        The hardware-optimized, autoscaling GitHub Actions runner fleet for developer workstations. 
        Instantly launches ephemeral Docker containers (<strong>~0.3s</strong>) for rapid builds, or provisions dedicated Linux Virtual Machines with full <code>systemd</code> and unconfined Chrome sandboxing for browser E2E tests.
      </p>

      <div class="hero-actions">
        <a href="#quickstart" class="btn-crimson">
          <span>⚡ INITIALIZE FLEET</span>
        </a>
        <a href={`${baseUrl}/docs/`} class="btn-ghost">
          <span>READ ARCHITECTURE DOCS →</span>
        </a>
      </div>

      <!-- Hardware CLI Workbench Terminal -->
      <Terminal />
    </section>

    <!-- Technical Architecture Grid -->
    <section class="features-section" id="features">
      <div class="section-tag">
        <span class="tag-accent">//</span>
        <span>SYSTEM_CAPABILITIES</span>
      </div>
      
      <div class="section-heading-group">
        <h2>Engineered for High-Performance Workstations</h2>
        <p>Direct host acceleration with zero Kubernetes control plane overhead and automated registry proxy caching.</p>
      </div>

      <div class="tech-grid">
        <div class="tech-card">
          <div class="card-icon-box">⚡</div>
          <h3>Dual-Engine Fleet</h3>
          <p>Execute jobs in ephemeral Docker containers (~0.3s boot, 20MB idle RAM) or dedicated Linux VMs (OrbStack / WSL2) with full <code>systemd</code> and unconfined Chrome sandboxing.</p>
          <div class="card-footer-meta">DRIVER: DOCKER + VM</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">🧠</div>
          <h3>Hybrid Auto-Routing</h3>
          <p>Inspects workflow labels in real time and automatically routes jobs with <code>browser</code>, <code>e2e</code>, <code>lighthouse</code>, or <code>systemd</code> labels to dedicated VMs while keeping unit tests in fast containers.</p>
          <div class="card-footer-meta">ROUTING: ZERO-CONFIG</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">🍏</div>
          <h3>Native ARM64 + Rosetta AMD64</h3>
          <p>Run native Apple Silicon ARM64 binaries at bare-metal speed, or run x86_64 AMD64 Docker containers simultaneously using OrbStack's Rosetta 2 acceleration.</p>
          <div class="card-footer-meta">ARCH: MULTI-PLATFORM</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">📦</div>
          <h3>Verdaccio &amp; Athens Caching</h3>
          <p>Integrated local caching proxy registries for npm (:49501), Go modules (:49500), and Docker Hub. Plus persistent host volume caching for pip, uv, yarn, and pnpm.</p>
          <div class="card-footer-meta">PROXIES: BUILT-IN</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">🌐</div>
          <h3>Adaptive Rate-Limiting &amp; Zombie Healing</h3>
          <p>Smart discovery filters active repositories, auto-cancels orphaned runs pinned to dead runners, and monitors GitHub API quota headers to guarantee zero rate-limit bans.</p>
          <div class="card-footer-meta">QUOTA: PROTECTED</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">🔒</div>
          <h3>Zero Kubernetes Overhead</h3>
          <p>No K8s control plane, no etcd, no Helm charts, and no cert-manager consuming 3.5GB of your laptop's RAM before a single job even starts.</p>
          <div class="card-footer-meta">IDLE RAM: ~20MB</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">🛡️</div>
          <h3>100% Mutation &amp; Unit Tested</h3>
          <p>Verified with unit tests, 0 Flake8 lint warnings, 100% Mypy static type safety, and Mutmut mutation testing across all drivers.</p>
          <div class="card-footer-meta">QUALITY: 100% VERIFIED</div>
        </div>

        <div class="tech-card">
          <div class="card-icon-box">🟢</div>
          <h3>Unified CI Toolchain</h3>
          <p>Single source of truth toolchain script: pre-installed Node.js 20/22/24 LTS via nvm, .NET SDK 8.0, Git LFS, PostgreSQL client, and Playwright OS dependencies.</p>
          <div class="card-footer-meta">TOOLCHAIN: READY</div>
        </div>
      </div>
    </section>

    <!-- Hybrid Auto-Routing Showcase -->
    <CodeShowcase />

    <!-- Engine Compatibility Section -->
    <section class="features-section" id="engines">
      <div class="section-tag">
        <span class="tag-accent">//</span>
        <span>COMPATIBILITY_MATRIX</span>
      </div>

      <div class="section-heading-group">
        <h2>Execution Engine Matrix</h2>
        <p>RunZero adapts to your operating system, supporting containers and full virtual machines across macOS, Windows, and Linux.</p>
      </div>

      <div class="table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Engine Driver</th>
              <th>Host OS</th>
              <th>Execution Mode</th>
              <th>Key Strengths</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>🪐 OrbStack (Recommended)</strong></td>
              <td>macOS (Apple Silicon &amp; Intel)</td>
              <td><span class="tag-crimson">Containers &amp; Linux VMs</span></td>
              <td>Instant boot, golden VM cloning, Rosetta 2 x86_64 acceleration, full systemd.</td>
            </tr>
            <tr>
              <td><strong>🐳 Docker Desktop</strong></td>
              <td>macOS, Windows, Linux</td>
              <td><span class="tag-crimson">Containers</span></td>
              <td>Universal cross-platform container support.</td>
            </tr>
            <tr>
              <td><strong>🪟 Windows WSL2</strong></td>
              <td>Windows 10/11 &amp; Server</td>
              <td><span class="tag-crimson">Native Linux VMs</span></td>
              <td>Native Linux execution without requiring Docker Desktop on Windows.</td>
            </tr>
            <tr>
              <td><strong>🚀 Canonical Multipass</strong></td>
              <td>macOS, Windows, Linux</td>
              <td><span class="tag-crimson">Virtual Machines</span></td>
              <td>Universal cross-platform Ubuntu VMs via QEMU / Hyper-V / VirtualBox.</td>
            </tr>
            <tr>
              <td><strong>🐧 Native Linux Docker</strong></td>
              <td>Ubuntu, Debian, Arch, Homelabs</td>
              <td><span class="tag-crimson">Native Containers</span></td>
              <td>Zero VM layer, direct kernel speed for homelab servers.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Competitive Comparison -->
    <ComparisonTable />

    <!-- Bottom Launch Banner -->
    <section class="launch-banner">
      <div class="banner-inner">
        <h2>DEPLOY LOCAL RUNNER FLEET NOW</h2>
        <p>Initialize your workstation fleet in less than 60 seconds with our interactive configuration wizard.</p>
        <div class="banner-actions">
          <a href="#quickstart" class="btn-crimson">⚡ QUICKSTART NOW</a>
          <a href={`${baseUrl}/docs/`} class="btn-ghost">BROWSE DOCUMENTATION →</a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .hero-section {
    padding: 80px 0 40px;
    text-align: center;
  }

  .hero-telemetry-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    background: rgba(255, 51, 85, 0.06);
    border: 1px solid var(--border-crimson);
    border-radius: var(--radius-sm);
    margin-bottom: 24px;
  }
  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--crimson);
    box-shadow: 0 0 8px var(--crimson);
  }
  .telemetry-text {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--crimson-light);
    letter-spacing: 0.08em;
  }
  .telemetry-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    padding: 1px 5px;
    background: var(--solar-dim);
    color: var(--solar-light);
    border-radius: 2px;
  }

  .hero-title {
    font-size: 4.2rem;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 24px;
  }

  .hero-lead {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 760px;
    margin: 0 auto 36px;
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }

  .features-section {
    padding: 72px 0;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--crimson-light);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .tag-accent { color: var(--text-dim); }

  .section-heading-group {
    margin-bottom: 48px;
  }
  .section-heading-group h2 {
    font-size: 2.4rem;
    margin-bottom: 10px;
  }
  .section-heading-group p {
    color: var(--text-muted);
    font-size: 1.08rem;
    max-width: 680px;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .card-icon-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background: rgba(255, 51, 85, 0.08);
    border: 1px solid var(--border-crimson);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 18px;
  }
  .tech-card h3 {
    font-size: 1.18rem;
    margin-bottom: 10px;
  }
  .tech-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .card-footer-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    color: var(--text-dim);
    letter-spacing: 0.06em;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .tag-crimson {
    color: var(--crimson-light);
    font-weight: 700;
  }

  .table-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
  }
  table.comparison-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 600px;
  }
  table.comparison-table th, table.comparison-table td {
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.92rem;
  }
  table.comparison-table th {
    background: rgba(255, 255, 255, 0.02);
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .launch-banner {
    padding: 60px 0 96px;
  }
  .banner-inner {
    background: linear-gradient(135deg, rgba(255, 51, 85, 0.08) 0%, rgba(16, 21, 34, 0.9) 100%);
    border: 1px solid var(--border-crimson);
    border-radius: var(--radius-lg);
    padding: 48px 32px;
    text-align: center;
    box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 30px -10px var(--crimson-dim);
  }
  .banner-inner h2 {
    font-size: 2.2rem;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .banner-inner p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 28px;
  }
  .banner-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.7rem; }
    .hero-lead { font-size: 1.05rem; }
  }
</style>
