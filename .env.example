# ==============================================================================
# GitHub Authentication
# ==============================================================================
# GitHub Personal Access Token (Classic) with 'repo' scope (and 'admin:org' if for an Org).
# Used to automatically discover repos, query queued jobs, and register/deregister runners.
# For the dashboard's GitHub Actions Minutes panel, this token must also be allowed
# to read billing data for the target OWNER/ORG scope.
ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere

# ==============================================================================
# Target Configuration (Choose one or combine)
# ==============================================================================
# Option A: Monitor all repositories owned by you (Auto-Discovery)
OWNER=your-username
AUTO_DISCOVER_REPOS=true

# Filter to active repositories: only monitor repos pushed to within the last N days (default: 60)
ACTIVE_REPO_DAYS=60

# Option B: Specific list of repositories (comma-separated) — fastest & avoids auto-discovery
# REPOS=your-username/your-repo,your-username/another-repo
# REPO=your-username/your-repo

# Option C: Organization-wide runners
# Runners register at org scope and serve queued self-hosted jobs from the org's
# active repositories (discovered from /orgs/<ORG>/repos, or REPOS if set).
# Needs a token that can manage org runners (admin:org / org "Self-hosted runners").
# ORG=your-org-name

# ==============================================================================
# Dual-Engine Architecture & VM Settings
# ==============================================================================
# Execution backend driver:
# - 'docker'      : Ultra-lightweight ephemeral Docker containers (fastest, ~20MB RAM)
# - 'orbstack-vm': Dedicated native Linux VMs on macOS via OrbStack (Full systemd, GUI/Chrome sandboxing)
# - 'wsl2'        : Windows WSL2 native Linux VM backend (Windows 10/11)
# - 'multipass'   : Cross-platform Ubuntu VMs via Canonical Multipass
# - 'auto'        : Automatically uses Docker baseline with Hybrid VM routing (Recommended)
RUNNER_BACKEND=auto

# Hybrid Auto-Routing: Automatically route jobs requiring full system rights (Chrome/Lighthouse,
# E2E tests, systemd daemons) to full VMs if available on the host machine. Routing checks both
# the job's `runs-on:` labels AND its GitHub-reported job name against VM_TRIGGER_LABELS below, so
# a job literally named "... E2E ..." or "... Lighthouse ..." routes to a VM automatically even if
# its workflow never adds a custom runs-on label for it.
AUTO_ROUTE_VM=true

# Comma-separated trigger words checked against both `runs-on:` labels and the job's name (both
# lowercased, word-tokenized -- not raw substring matching, so short words like "vm" can't
# false-positive inside an unrelated word).
VM_TRIGGER_LABELS=vm,browser,e2e,lighthouse,systemd,gui,unconfined,postgres,mysql,redis,db,database,integration,service,services,dind

# Docker network mode for the Docker driver's spawned runner containers (jobs NOT routed to a VM).
# 'host' (recommended) shares the Docker host's network stack directly -- providing seamless
# GitHub-hosted parity for `services:` and `docker run` containers reachable at `localhost:PORT`.
# When combined with dynamic/ephemeral ports (e.g. `ports: - 5432`), concurrent jobs never collide.
DOCKER_NETWORK=host

# Which architecture runner to spin up:
# - 'arm64' : Native Apple Silicon execution (ultra fast)
# - 'amd64' : Intel/AMD x86_64 execution (via OrbStack Rosetta emulation)
# - 'both'  : Support both architectures simultaneously!
RUNNER_ARCH=both

# Warm standby pool (0 = only spin up when a job is waiting). After queued jobs are
# served, the fleet is topped up to MIN_RUNNERS runners (never above MAX_RUNNERS):
# at org scope in ORG mode, otherwise round-robin across the tracked repositories
# (a repo-scoped runner can only take that repo's jobs). Up to MIN_RUNNERS idle
# runners are exempt from idle-orphan reaping. Must not exceed MAX_RUNNERS.
MIN_RUNNERS=0

# Maximum simultaneous runner instances to allow on this machine
MAX_RUNNERS=4

# Per-runner CPU core / memory ceiling, applied to every Docker container (`docker run
# --cpus/--memory`), every OrbStack job VM (set on each clone) and every Multipass VM.
# Left empty, each runner gets an equal share of the host (for OrbStack: of its VM pool,
# `orb config show` cpu/memory_mib) after keeping 1 CPU and 2 GiB for the proxies, the
# bridge and the OS: cpus = (host_cpus - 1) // MAX_RUNNERS. Without limits, MAX_RUNNERS
# concurrent runners each claim every host core, and CPU-heavy jobs (Vitest/Jest sizing
# their worker pool to the reported core count) starve into test timeouts. The startup
# log and the dashboard show the sizing and warn when MAX_RUNNERS x RUNNER_CPUS (or
# RUNNER_MEMORY) exceeds the host. RUNNER_SIZING=unlimited restores the old no-limits mode.
# RUNNER_CPUS=2
# RUNNER_MEMORY=4g
# RUNNER_SIZING=auto

# Destroy runners when the autoscaler stops. Off by default: runners are ephemeral and
# exit after their job, so a restart/redeploy no longer cancels in-flight jobs.
# CLEANUP_RUNNERS_ON_SHUTDOWN=false

# Serve amd64-labelled jobs with native arm64 runners on Apple Silicon, without changing
# the workflow (it keeps `runs-on: [self-hosted, local, amd64]` and keeps working on
# GitHub-hosted ubuntu-latest). Much faster than Rosetta for Node/pnpm/Playwright/Go jobs.
# A job that checks `uname -m` or builds amd64 artifacts without `--platform` gets arm64,
# so list only repos where that's fine. Jobs labelled `rosetta`/`x86_64` are never moved.
# Values: off (default) | all | owner/repo,owner/other-repo. No-op on amd64 hosts.
# NATIVE_ARCH_OVERRIDE=off

# How often (in seconds) the autoscaler checks GitHub for queued actions
POLL_INTERVAL=10

# How often (in seconds) to refresh auto-discovered repo list
DISCOVERY_INTERVAL=900

# How often (in seconds) to refresh GitHub API rate-limit telemetry
RATE_LIMIT_REFRESH_INTERVAL=60

# How often (in seconds) to refresh GitHub Actions billing usage telemetry
ACTIONS_BILLING_REFRESH_INTERVAL=300

# ==============================================================================
# Proxy Registries & Caching Settings
# ==============================================================================
# Enable Verdaccio (NPM), Athens (Go) and Docker Registry mirror
PROXIES_ENABLED=true

# Enable shared multi-language package & tool caching across all runner containers
CACHE_ENABLED=true

# Location on host machine to store shared caches. REQUIRED when CACHE_ENABLED=true.
# Must be a real path on the Docker HOST (not a path inside a container) — the
# autoscaler runs containerized itself, so a relative/expanduser default here
# would silently resolve to a path inside the autoscaler's own container instead
# of your actual Mac/Linux filesystem, breaking caching with no error at all.
HOST_CACHE_DIR=/Users/youruser/.local-github-runner/cache

# ==============================================================================
# Web UI Dashboard & Observability
# ==============================================================================
# Real-Time dark-mode Web UI Dashboard with Live Fleet Monitoring, SSE streaming,
# Hybrid Routing Telemetry, Cache Analytics, and interactive fleet controls.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=49505

# ==============================================================================
# Host VM Bridge (for Containerized Autoscaler)
# ==============================================================================
# Allows the containerized autoscaler to manage host-native VMs (OrbStack, WSL2, Multipass).
HOST_VM_BRIDGE_PORT=49504
# HOST_VM_BRIDGE_URL=http://host.docker.internal:49504
# Shared secret the autoscaler sends to the bridge (Authorization: Bearer ...).
# `make env` generates one. Required if HOST_VM_BRIDGE_HOST is not a loopback address.
# RUNZERO_BRIDGE_TOKEN=
# The bridge binds 127.0.0.1 by default; Docker Desktop / OrbStack containers still reach
# it as host.docker.internal. On Linux Docker, set this to the docker0 address (plus a token).
# HOST_VM_BRIDGE_HOST=127.0.0.1
# Extra hostnames the dashboard and bridge accept in the Host header (comma-separated),
# e.g. a LAN name when publishing the dashboard with DASHBOARD_PUBLISH_ADDR=0.0.0.0.
# RUNZERO_ALLOWED_HOSTS=
# DASHBOARD_PUBLISH_ADDR=127.0.0.1

