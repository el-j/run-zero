              <button class="btn btn-xs btn-outline action-btn" data-action="cancel" data-repo="" data-run-id="undefined" title="Cancel Run">✕</button>
              <button class="btn btn-xs btn-outline action-btn" data-action="rerun" data-repo="" data-run-id="undefined" title="Re-run All">↺</button>
              <button class="btn btn-xs btn-outline action-btn" data-action="rerun-failed" data-repo="" data-run-id="undefined" title="Re-run Failed">↻</button>
            </td>
          </tr>
        "
`;
