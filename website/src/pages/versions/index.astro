---
import Layout from '../../layouts/Layout.astro';
import versionsData from '../../../public/versions.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentDocsBaseUrl = versionsData[0]?.url.replace(/\/v\d+\.\d+\.\d+\/$/, '') || baseUrl;
---

<Layout title="Releases & Version Archive — RunZero" description="Archive of all RunZero documentation releases and release notes." currentPath="/versions" currentVersion={import.meta.env.PUBLIC_DOCS_VERSION || 'main'}>
  <div class="ambient-crimson"></div>
  <div class="ambient-solar"></div>

  <div class="container">
    <section class="versions-section">
      <div class="section-header">
        <h1>Documentation Releases &amp; Version Archive</h1>
        <p>Browse version-pinned documentation snapshots for specific RunZero releases, or jump to GitHub release changelogs.</p>
      </div>

      <div class="callout info current-docs-callout">
        <div class="callout-title">⚡ Current Documentation</div>
        <p>
          The live documentation at <code>/run-zero/</code> tracks the latest site deployed from <code>main</code>. Use the release snapshots below when you need docs that match an older installed version.
        </p>
        <div class="card-actions" style="margin-top: 18px;">
          <a href={`${currentDocsBaseUrl}/`} class="btn-crimson">
            Open Current Docs →
          </a>
        </div>
      </div>

      <div class="versions-grid">
        {versionsData.map((v) => (
          <div class={`version-card ${v.status === 'latest' ? 'highlight-latest' : ''}`}>
            <div class="card-top">
              <div class="version-header">
                <h3>{v.version}</h3>
                <span class={`status-badge ${v.status}`}>{v.status === 'latest' ? '⚡ Latest Release' : 'Archived'}</span>
              </div>
              <span class="release-date">Released on {v.releaseDate}</span>
            </div>

            <p class="version-notes">{v.notes}</p>

            <div class="card-actions">
              <a href={v.docsUrl} class="btn-crimson">
                Browse {v.version} Docs →
              </a>
              <a href={v.changelogUrl} class="btn-ghost" target="_blank" rel="noopener">
                Changelog on GitHub ↗
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="callout info" style="margin-top: 48px;">
        <div class="callout-title">💡 How Multi-Version Documentation Works in RunZero</div>
        <p>
          Each stable SemVer release gets its own static snapshot under <code>/{'{version}'}/</code> on the <code>gh-pages</code> branch, while the root of the site continues to serve the current docs built from <code>main</code>.
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  .versions-section {
    padding: 72px 0 96px;
    max-width: 920px;
    margin: 0 auto;
  }
  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .section-header h1 {
    font-size: 2.8rem;
    font-weight: 800;
    margin-bottom: 14px;
  }
  .section-header p {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 680px;
    margin: 0 auto;
  }

  .versions-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .version-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: all 0.2s ease;
  }
  .version-card.highlight-latest {
    border-color: var(--border-crimson);
    background: rgba(16, 21, 34, 0.95);
    box-shadow: 0 15px 35px -10px var(--crimson-dim);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }
  .version-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .version-header h3 {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
    color: #fff;
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
  }
  .status-badge.latest {
    background: var(--solar-dim);
    color: var(--solar-light);
    border: 1px solid var(--border-amber);
  }
  .status-badge.archived {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-dim);
    border: 1px solid var(--border-subtle);
  }

  .release-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .version-notes {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  .card-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .callout {
    padding: 20px 24px;
    border-radius: var(--radius-md);
    border-left: 4px solid var(--crimson);
    background: var(--crimson-dim);
  }
  .callout-title {
    font-weight: 700;
    margin-bottom: 6px;
    color: #fff;
  }
  .callout p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }
</style>
