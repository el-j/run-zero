---
import versionsData from "../../public/versions.json";

interface Props {
  currentVersion?: string;
}

const { currentVersion = "main" } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentEntry = versionsData.find(
  (version) => version.version === currentVersion,
);
const currentVersionTag =
  currentVersion === "main"
    ? "CURRENT"
    : currentEntry?.status === "latest"
      ? "LATEST"
      : "ARCHIVED";
const archiveIndexBaseUrl =
  versionsData[0]?.url.replace(/\/v\d+\.\d+\.\d+\/$/, "") || baseUrl;
---

<div class="version-switcher" id="version-switcher">
  <button
    class="version-btn"
    id="version-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label="Select documentation version"
  >
    <span class="version-dot"></span>
    <span class="version-label">{currentVersion}</span>
    <span class="version-tag">{currentVersionTag}</span>
    <svg
      class="chevron-icon"
      width="10"
      height="10"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
    >
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </button>

  <div class="version-dropdown" id="version-dropdown">
    <div class="dropdown-header">// RELEASES_MANIFEST</div>
    {
      versionsData.map((v) => (
        <a
          href={v.url}
          class={`version-item ${v.version === currentVersion ? "active" : ""}`}
        >
          <div class="item-title">
            <span>{v.version}</span>
            {v.status === "latest" && (
              <span class="badge-pill latest">LATEST</span>
            )}
            {v.status === "archived" && (
              <span class="badge-pill archived">ARCHIVED</span>
            )}
          </div>
          <span class="item-desc">{v.notes}</span>
        </a>
      ))
    }

    <div class="dropdown-footer">
      <a href={`${archiveIndexBaseUrl}/versions/`} class="all-versions-link"
        >// ARCHIVE_INDEX →</a
      >
    </div>
  </div>
</div>

<style>
  .version-switcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .version-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }
  .version-btn:hover {
    background: var(--crimson-dim);
    border-color: var(--border-crimson);
  }

  .version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--crimson);
    box-shadow: 0 0 6px var(--crimson);
  }

  .version-tag {
    font-size: 0.62rem;
    padding: 1px 4px;
    background: var(--solar-dim);
    color: var(--solar-light);
    border-radius: 2px;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
    color: var(--text-dim);
  }
  .version-btn.open .chevron-icon {
    transform: rotate(180deg);
  }

  .version-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 240px;
    background: var(--bg-surface);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    padding: 8px;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.9);
    z-index: 200;
  }
  .version-dropdown.show {
    display: block;
  }

  .dropdown-header {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    font-weight: 700;
    padding: 4px 6px 8px;
  }

  .version-item {
    display: block;
    padding: 8px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--text-main);
    transition: background 0.2s ease;
  }
  .version-item:hover,
  .version-item.active {
    background: rgba(255, 255, 255, 0.04);
  }
  .version-item.active {
    border-left: 2px solid var(--crimson);
  }

  .item-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.82rem;
  }

  .badge-pill {
    font-size: 0.62rem;
    padding: 1px 5px;
    border-radius: 2px;
    font-weight: 800;
  }
  .badge-pill.latest {
    background: var(--solar-dim);
    color: var(--solar-light);
  }
  .badge-pill.archived {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-dim);
  }

  .item-desc {
    display: block;
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-top: 2px;
  }

  .dropdown-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: 6px;
    padding-top: 6px;
  }
  .all-versions-link {
    display: block;
    padding: 4px 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--crimson-light);
    text-decoration: none;
    font-weight: 700;
  }
  .all-versions-link:hover {
    text-decoration: underline;
  }
</style>

<script>
  const btn = document.getElementById("version-btn");
  const dropdown = document.getElementById("version-dropdown");

  if (btn && dropdown) {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      btn.classList.toggle("open");
      dropdown.classList.toggle("show");
    });

    document.addEventListener("click", () => {
      btn.classList.remove("open");
      dropdown.classList.remove("show");
    });
  }
</script>
