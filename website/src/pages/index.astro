---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import CodeShowcase from '../components/CodeShowcase.astro';
import ComparisonTable from '../components/ComparisonTable.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="RunZero ⚡ Zero-Bloat Local GitHub Actions Runner Fleet" currentPath="/">
  <div class="container">
    
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-tag">
        <span class="dot-pulse"></span>
        <span>Dual-Engine: Docker Containers + Dedicated Linux VMs</span>
      </div>

      <h1>
        Run GitHub Actions Locally.<br />
        <span class="gradient-text">Zero Cloud Minutes. Zero K8s Bloat.</span>
      </h1>

      <p class="hero-subtitle">
        The lightweight, autoscaling GitHub Actions runner fleet for your workstation. Choose ultra-fast Docker containers (~0.3s) for rapid unit tests or dedicated Linux Virtual Machines (OrbStack, WSL2, Multipass) for browser E2E, Lighthouse, and full systemd isolation.
      </p>

      <div class="hero-cta">
        <a href="#quickstart" class="btn-primary">Get Started in 1 Minute</a>
        <a href={`${baseUrl}/docs/`} class="btn-secondary">Explore Documentation →</a>
      </div>

      <!-- Interactive Quickstart Terminal -->
      <Terminal />
    </section>

    <!-- 8-Card Features Grid -->
    <section class="features" id="features">
      <div class="section-header">
        <h2>Engineered for High-Performance CI</h2>
        <p>Built specifically for local developer workstations, Apple Silicon MacBooks, and homelabs.</p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">⚡</div>
          <h3>Dual-Engine Fleet</h3>
          <p>Execute jobs in ultra-fast Docker containers (~0.3s boot, ~20MB RAM) or dedicated Linux VMs (OrbStack / WSL2) with full <code>systemd</code> and unconfined Chrome sandboxing.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🧠</div>
          <h3>Hybrid Auto-Routing</h3>
          <p>RunZero automatically detects workflow labels like <code>browser</code>, <code>e2e</code>, <code>lighthouse</code>, or <code>systemd</code> and routes them to dedicated VMs while keeping standard unit tests in fast containers.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🍏</div>
          <h3>Native ARM64 + Rosetta AMD64</h3>
          <p>Run blazing-fast Apple Silicon builds natively, or execute x86_64 AMD64 Docker containers via OrbStack's Rosetta acceleration on the same MacBook without configuration changes.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">📦</div>
          <h3>Verdaccio &amp; Athens Caching</h3>
          <p>Built-in local proxy registries for npm, Go modules, and Docker Hub. Plus persistent volume caching for pip, uv, yarn, pnpm, and <code>actions/setup-*</code>.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <h3>Adaptive Rate-Limiting</h3>
          <p>Smart discovery filters to active repositories and real-time GitHub API header tracking to guarantee you stay well below the 5,000 req/hr ceiling.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Zero Kubernetes Overhead</h3>
          <p>No K8s control plane, no etcd, no Helm charts, and no cert-manager consuming 3GB of your laptop's RAM before a single job runs.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🛡️</div>
          <h3>100% Mutation &amp; Unit Tested</h3>
          <p>Rock-solid codebase with 68 comprehensive tests, 0 Flake8 warnings, 100% Mypy static type safety, and Mutmut mutation testing.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🟢</div>
          <h3>Dynamic NVM &amp; .NET 8 Pre-baked</h3>
          <p>Zero wait time: pre-installed Node.js 20 LTS, 22 LTS, 24 Current, .NET SDK 8.0, Git LFS, PostgreSQL client, and Google Chrome.</p>
        </div>
      </div>
    </section>

    <!-- Hybrid Auto-Routing Code Showcase -->
    <CodeShowcase />

    <!-- Dual-Engine Compatibility Table -->
    <section class="comparison-section" id="engines">
      <div class="section-header">
        <h2>Container &amp; VM Engine Compatibility</h2>
        <p>RunZero supports containers and full virtual machines across macOS, Windows, and Linux.</p>
      </div>

      <div class="table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th>Engine / Driver</th>
              <th>Supported Host OS</th>
              <th>Execution Type</th>
              <th>Key Strengths</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>🪐 OrbStack (Recommended)</strong></td>
              <td>macOS (Apple Silicon &amp; Intel)</td>
              <td><span class="check-yes">Containers &amp; Linux VMs</span></td>
              <td>Instant boot, Rosetta 2 x86_64 acceleration, full systemd support.</td>
            </tr>
            <tr>
              <td><strong>🐳 Docker Desktop</strong></td>
              <td>macOS, Windows, Linux</td>
              <td><span class="check-yes">Containers</span></td>
              <td>Universal cross-platform container support.</td>
            </tr>
            <tr>
              <td><strong>🪟 Windows WSL2</strong></td>
              <td>Windows 10/11 &amp; Server</td>
              <td><span class="check-yes">Native Linux VMs</span></td>
              <td>Native Linux execution without requiring Docker Desktop on Windows.</td>
            </tr>
            <tr>
              <td><strong>🚀 Canonical Multipass</strong></td>
              <td>macOS, Windows, Linux</td>
              <td><span class="check-yes">Virtual Machines</span></td>
              <td>Universal cross-platform Ubuntu VMs via QEMU / Hyper-V / VirtualBox.</td>
            </tr>
            <tr>
              <td><strong>🐧 Native Linux Docker</strong></td>
              <td>Ubuntu, Debian, Arch, Homelabs</td>
              <td><span class="check-yes">Native Containers</span></td>
              <td>Zero VM layer, direct kernel speed for homelab servers.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Competitive Landscape -->
    <ComparisonTable />

    <!-- Bottom CTA Banner -->
    <section class="hero" style="padding: 40px 0 80px;">
      <h2>Ready to Supercharge Your Local CI?</h2>
      <p class="hero-subtitle" style="margin-bottom: 32px;">
        Clone the repository and spin up your local runner fleet in 60 seconds.
      </p>
      <div class="hero-cta">
        <a href="#quickstart" class="btn-primary">Launch RunZero</a>
        <a href={`${baseUrl}/docs/`} class="btn-secondary">Read the Full Docs →</a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .hero {
    padding: 96px 0 72px;
    text-align: center;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid var(--border-accent);
    border-radius: 999px;
    color: var(--primary-light);
    font-size: 0.88rem;
    font-weight: 700;
    margin-bottom: 28px;
  }
  .dot-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--emerald);
    box-shadow: 0 0 10px var(--emerald);
  }

  .hero h1 {
    font-size: 3.8rem;
    font-weight: 800;
    line-height: 1.12;
    margin-bottom: 24px;
    background: linear-gradient(180deg, #ffffff 40%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 780px;
    margin: 0 auto 40px;
    line-height: 1.65;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 56px;
    flex-wrap: wrap;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-bottom: 80px;
  }
  .feature-card {
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .feature-card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-accent);
    transform: translateY(-4px);
  }
  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 20px;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.25);
    color: var(--primary-light);
  }
  .feature-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .feature-card p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .comparison-section {
    padding: 60px 0 80px;
  }
  .section-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .section-header h2 {
    font-size: 2.4rem;
    font-weight: 800;
    margin-bottom: 12px;
  }
  .section-header p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 620px;
    margin: 0 auto;
  }

  .table-wrapper {
    background: var(--bg-card);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
  }
  table.comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  table.comparison-table th, table.comparison-table td {
    padding: 18px 24px;
    border-bottom: 1px solid var(--border-subtle);
  }
  table.comparison-table th {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.02);
  }
  .check-yes { color: var(--emerald); font-weight: bold; }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.5rem; }
    .hero-subtitle { font-size: 1.05rem; }
  }
</style>
