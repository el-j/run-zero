<h2 id="env-reference">Environment Variables Reference (<code>.env</code>)</h2>
<div class="table-wrapper">
  <table class="comparison-table">
    <thead>
      <tr>
        <th>Variable</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>ACCESS_TOKEN</code></td>
        <td><em>Required</em></td>
        <td
          >GitHub Personal Access Token (classic with <code>repo</code> scope). For Actions minutes panel, token must also have billing-read access for target owner/org.</td
        >
      </tr>
      <tr>
        <td><code>OWNER</code></td>
        <td><em>Required</em></td>
        <td>GitHub username to monitor for auto-discovery.</td>
      </tr>
      <tr>
        <td><code>RUNNER_BACKEND</code></td>
        <td><code>auto</code></td>
        <td
          >Execution engine: <code>auto</code>, <code>docker</code>, <code
            >orbstack-vm</code
          >, <code>wsl2</code>, <code>multipass</code>.</td
        >
      </tr>
      <tr>
        <td><code>AUTO_ROUTE_VM</code></td>
        <td><code>true</code></td>
        <td
          >Automatically route jobs with <code>browser</code>/<code>e2e</code
          >/<code>systemd</code> labels to VMs.</td
        >
      </tr>
      <tr>
        <td><code>RUNNER_ARCH</code></td>
        <td><code>both</code></td>
        <td
          >Target architecture: <code>both</code> (ARM64 + AMD64), <code
            >arm64</code
          >, <code>amd64</code>.</td
        >
      </tr>
      <tr>
        <td><code>ACTIVE_REPO_DAYS</code></td>
        <td><code>60</code></td>
        <td>Only monitor repositories with commits in the last N days.</td>
      </tr>
      <tr>
        <td><code>MAX_RUNNERS</code></td>
        <td><code>4</code></td>
        <td>Maximum concurrent runner instances allowed on this workstation.</td
        >
      </tr>
      <tr>
        <td><code>PROXIES_ENABLED</code></td>
        <td><code>true</code></td>
        <td
          >Start apt-cacher, Verdaccio, Athens, and Docker Hub caching proxies.</td
        >
      </tr>
      <tr>
        <td><code>RATE_LIMIT_REFRESH_INTERVAL</code></td>
        <td><code>60</code></td>
        <td>Polling interval (seconds) for GitHub API quota telemetry updates.</td>
      </tr>
      <tr>
        <td><code>ACTIONS_BILLING_REFRESH_INTERVAL</code></td>
        <td><code>300</code></td>
        <td>Polling interval (seconds) for GitHub Actions minutes billing updates.</td>
      </tr>
    </tbody>
  </table>
</div>
