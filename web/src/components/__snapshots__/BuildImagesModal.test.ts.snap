// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`BuildImagesModal output > renders every kind of image card 1`] = `
"
      <div class="glass-panel" style="padding: 12px 14px; border-left: 3px solid var(--accent-emerald, #10b981);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span class="font-mono" style="font-weight: 600; font-size: 13px;">vm-a</span>
              <span class="tech-chip purple font-mono" style="font-size: 10px;">ARM64</span>
            </div>
            <div class="font-mono text-muted" style="font-size: 11px; margin-top: 4px;">OrbStack Linux VM • Runner v2.3</div>
          </div>
          <span class="tech-chip tag-emerald font-mono" style="font-size: 11px; text-transform: uppercase;">
            ready
          </span>
        </div>
      </div>
    
      <div class="glass-panel" style="padding: 12px 14px; border-left: 3px solid var(--solar, #f59e0b);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span class="font-mono" style="font-weight: 600; font-size: 13px;">vm-b</span>
              <span class="tech-chip purple font-mono" style="font-size: 10px;">AMD64</span>
            </div>
            <div class="font-mono text-muted" style="font-size: 11px; margin-top: 4px;">OrbStack Linux VM • Ubuntu Noble base</div>
          </div>
          <span class="tech-chip tag-amber font-mono" style="font-size: 11px; text-transform: uppercase;">
            stale
          </span>
        </div>
      </div>
    
      <div class="glass-panel" style="padding: 12px 14px; border-left: 3px solid var(--crimson, #ef4444);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
          <div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span class="font-mono" style="font-weight: 600; font-size: 13px;">c-a</span>
              <span class="tech-chip cyan font-mono" style="font-size: 10px;">ARM64</span>
            </div>
            <div class="font-mono text-muted" style="font-size: 11px; margin-top: 4px;">Docker Runner • Size: 1 GB</div>
          </div>
          <span class="tech-chip tag-crimson font-mono" style="font-size: 11px; text-transform: uppercase;">
            missing
