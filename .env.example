# ==============================================================================
# GitHub Authentication
# ==============================================================================
# GitHub Personal Access Token (Classic) with 'repo' scope (and 'admin:org' if for an Org).
# Used to automatically discover repos, query queued jobs, and register/deregister runners.
ACCESS_TOKEN=ghp_yourPersonalAccessTokenHere

# ==============================================================================
# Target Configuration (Choose one or combine)
# ==============================================================================
# Option A: Monitor all repositories owned by you (Auto-Discovery)
OWNER=el-j
AUTO_DISCOVER_REPOS=true

# Option B: Specific list of repositories (comma-separated)
# REPOS=el-j/test-bot-repo,el-j/another-repo
# REPO=el-j/test-bot-repo

# Option C: Organization-wide runners
# ORG=your-org-name

# ==============================================================================
# Architecture & Concurrency Settings (OrbStack on Apple Silicon)
# ==============================================================================
# Which architecture runner containers to spin up:
# - 'arm64' : Native Apple Silicon execution (ultra fast)
# - 'amd64' : Intel/AMD x86_64 execution (via OrbStack Rosetta emulation)
# - 'both'  : Support both architectures simultaneously!
RUNNER_ARCH=both

# Minimum runners always on standby (0 = only spin up when a job is waiting)
MIN_RUNNERS=0

# Maximum simultaneous runner containers to allow on this machine
MAX_RUNNERS=4

# How often (in seconds) the autoscaler checks GitHub for queued actions
POLL_INTERVAL=5
