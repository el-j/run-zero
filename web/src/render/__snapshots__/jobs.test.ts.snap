                <a href="https://github.com/o/r/actions/runs/100" target="_blank" rel="noopener noreferrer" style="font-weight: 700; color: var(--text-main); text-decoration: none;">
                  bad
                </a>
              </div>
              <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; flex-wrap: wrap; gap: 0.5rem;">
                <span class="font-mono">o/r</span>
                
                
                
              </div>
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted); text-align: right;">
              <div class="font-mono">2026-01-01T00:00:00.000Z</div>
              
            </div>
          </div>

          <div style="display: flex; flex-direction: column; gap: 0.35rem;">
            <div style="font-size: 0.8rem; color: var(--text-main); font-weight: 600;">Why it failed</div>
            <div style="font-size: 0.82rem; color: var(--solar); line-height: 1.5;">
              boom
