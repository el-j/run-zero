---
// Hardware CLI Workbench Terminal Component
---

<div class="terminal-workbench" id="quickstart">
  <div class="workbench-header">
    <div class="workbench-status">
      <span class="status-box"></span>
      <span class="workbench-title">CLI_PROMPT // AUTO_DAEMON</span>
    </div>

    <div class="workbench-tabs">
      <button class="wtab-btn active" data-tab="quickstart">[1] SETUP</button>
      <button class="wtab-btn" data-tab="orbstack">[2] ORBSTACK_VM</button>
      <button class="wtab-btn" data-tab="wsl">[3] WSL2_WIN</button>
      <button class="wtab-btn" data-tab="multipass">[4] MULTIPASS</button>
    </div>

    <button class="btn-copy-code" id="btn-copy-code" aria-label="Copy terminal commands">
      <span class="copy-icon">⎘</span>
      <span class="copy-text">COPY</span>
    </button>
  </div>

  <div class="workbench-body">
    <div class="line-numbers">
      <span>01</span>
      <span>02</span>
      <span>03</span>
      <span>04</span>
      <span>05</span>
      <span>06</span>
      <span>07</span>
      <span>08</span>
    </div>
    <pre class="terminal-pre"><code id="terminal-code"><span class="c"># 1. Clone repository and run interactive setup wizard</span>
<span class="prompt">❯</span> <span class="cmd">git clone</span> git@github.com:el-j/run-zero.git
<span class="prompt">❯</span> <span class="cmd">cd</span> run-zero &amp;&amp; <span class="cmd">make env</span>

<span class="c"># 2. Launch Autoscaler &amp; local proxy registries</span>
<span class="prompt">❯</span> <span class="cmd">make start</span>

<span class="c"># 3. Stream real-time ephemeral runner telemetry</span>
<span class="prompt">❯</span> <span class="cmd">make logs</span></code></pre>
  </div>

  <div class="workbench-footer">
    <span class="footer-telemetry">⚡ ENGINE: AUTO_DETECT // IDLE_RAM: 20MB // BOOT: 0.3s</span>
  </div>
</div>

<style>
  .terminal-workbench {
    max-width: 820px;
    margin: 0 auto 96px;
    background: var(--bg-code);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.9), 0 0 30px -10px var(--volt-dim);
    text-align: left;
    position: relative;
  }
  .terminal-workbench::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--volt), transparent);
  }

  .workbench-header {
    background: rgba(255, 255, 255, 0.02);
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
  }

  .workbench-status {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .status-box {
    width: 8px;
    height: 8px;
    background: var(--volt);
    border-radius: 1px;
    box-shadow: 0 0 8px var(--volt);
  }
  .workbench-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .workbench-tabs {
    display: flex;
    gap: 4px;
  }
  .wtab-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .wtab-btn:hover {
    color: var(--text-main);
  }
  .wtab-btn.active {
    background: var(--volt-dim);
    border-color: var(--border-volt);
    color: var(--volt);
  }

  .btn-copy-code {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: all 0.2s ease;
  }
  .btn-copy-code:hover {
    background: var(--volt-dim);
    border-color: var(--border-volt);
    color: var(--volt);
  }

  .workbench-body {
    display: flex;
    padding: 20px 24px;
    background: #06080e;
    overflow-x: auto;
  }

  .line-numbers {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.85;
    color: #2a3346;
    user-select: none;
    padding-right: 18px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    margin-right: 18px;
  }

  .terminal-pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    line-height: 1.85;
    color: #e2e8f0;
    flex: 1;
    overflow-x: auto;
  }
  .terminal-pre .c { color: #52617a; }
  .terminal-pre .prompt { color: var(--volt); font-weight: bold; margin-right: 4px; }
  .terminal-pre .cmd { color: #fff; font-weight: 600; }

  .workbench-footer {
    padding: 8px 16px;
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid var(--border-subtle);
  }
  .footer-telemetry {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  @media (max-width: 768px) {
    .workbench-tabs { display: none; }
    .line-numbers { display: none; }
    .workbench-body { padding: 16px; }
  }
</style>

<script>
  const snippets = {
    quickstart: `# 1. Clone repository and run interactive setup wizard
❯ git clone git@github.com:el-j/run-zero.git
❯ cd run-zero && make env

# 2. Launch Autoscaler & local proxy registries
❯ make start

# 3. Stream real-time ephemeral runner telemetry
❯ make logs`,
    orbstack: `# Configure OrbStack macOS Linux VM backend
# Inside .env:
RUNNER_BACKEND=orbstack-vm
RUNNER_ARCH=both
AUTO_ROUTE_VM=true

# Launch runners:
❯ make start`,
    wsl: `# Configure Windows WSL2 Linux VM backend
# Inside .env:
RUNNER_BACKEND=wsl2
RUNNER_ARCH=amd64

# Launch runners:
❯ make start`,
    multipass: `# Configure Cross-Platform Multipass Ubuntu VMs
# Inside .env:
RUNNER_BACKEND=multipass

# Launch runners:
❯ make start`
  };

  const tabs = document.querySelectorAll('.wtab-btn');
  const codeBox = document.getElementById('terminal-code');
  const copyBtn = document.getElementById('btn-copy-code');

  if (tabs && codeBox) {
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.getAttribute('data-tab');
        if (target && snippets[target]) {
          codeBox.innerHTML = snippets[target]
            .replace(/^(#.*)$/gm, '<span class="c">$1</span>')
            .replace(/^(❯)/gm, '<span class="prompt">❯</span>');
        }
      });
    });
  }

  if (copyBtn && codeBox) {
    copyBtn.addEventListener('click', () => {
      const rawText = codeBox.textContent ? codeBox.textContent.replace(/^❯ /gm, '') : '';
      navigator.clipboard.writeText(rawText).then(() => {
        const textSpan = copyBtn.querySelector('.copy-text');
        if (textSpan) {
          textSpan.textContent = 'COPIED!';
          copyBtn.style.color = 'var(--volt)';
          copyBtn.style.borderColor = 'var(--volt)';
          setTimeout(() => {
            textSpan.textContent = 'COPY';
            copyBtn.style.color = '';
            copyBtn.style.borderColor = '';
          }, 2000);
        }
      });
    });
  }
</script>
