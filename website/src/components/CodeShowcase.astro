---
// Hybrid Auto-Routing Technical Showcase (Martian Redshift Edition)
---

<section class="routing-showcase" id="routing">
  <div class="section-tag">
    <span class="tag-accent">//</span>
    <span>DISPATCH_LOGIC</span>
  </div>

  <div class="section-heading-group">
    <h2>Hybrid Auto-Routing Engine</h2>
    <p>
      Zero cluster switching. RunZero inspects your job labels and dispatches
      either to ultra-fast container runtimes or dedicated virtual machines.
    </p>
  </div>

  <div class="routing-split">
    <!-- Stream 1: Ephemeral Container -->
    <div class="split-card container-mode">
      <div class="card-top-bar">
        <div class="mode-info">
          <span class="mode-badge docker">EPHEMERAL_DOCKER</span>
          <span class="mode-title">Unit Tests &amp; Builds</span>
        </div>
        <div class="mode-metrics">
          <span class="metric-pill">~0.3s BOOT</span>
          <span class="metric-pill crimson">20MB IDLE</span>
        </div>
      </div>

      <div class="code-editor-box">
        <div class="editor-gutter">
          <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span
          ><span>6</span>
        </div>
        <pre
          class="editor-code"><code><span class="k">jobs:</span>
  <span class="k">test-suite:</span>
    <span class="k">runs-on:</span> <span class="label-match">[ self-hosted, local ]</span>
    <span class="k">steps:</span>
      - <span class="k">uses:</span> <span class="v">actions/checkout@v7</span>
      - <span class="k">run:</span> <span class="v">npm test</span></code></pre>
      </div>

      <div class="card-bottom-telemetry">
        <span>⚡ RUNTIME: CONTAINER // SOCKET: HOST // ISOLATION: CGROUP</span>
      </div>
    </div>

    <!-- Stream 2: Dedicated Linux VM -->
    <div class="split-card vm-mode">
      <div class="card-top-bar">
        <div class="mode-info">
          <span class="mode-badge vm">DEDICATED_LINUX_VM</span>
          <span class="mode-title">Browser E2E &amp; Systemd</span>
        </div>
        <div class="mode-metrics">
          <span class="metric-pill">FULL OS</span>
          <span class="metric-pill solar">SYSTEMD</span>
        </div>
      </div>

      <div class="code-editor-box">
        <div class="editor-gutter">
          <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span
          ><span>6</span>
        </div>
        <pre
          class="editor-code"><code><span class="k">jobs:</span>
  <span class="k">browser-audit:</span>
    <span class="k">runs-on:</span> <span class="label-match vm">[ self-hosted, local, browser ]</span>
    <span class="k">steps:</span>
      - <span class="k">uses:</span> <span class="v">actions/checkout@v7</span>
      - <span class="k">run:</span> <span class="v">npx lhci autorun</span></code></pre>
      </div>

      <div class="card-bottom-telemetry">
        <span
          >🛡️ RUNTIME: VIRT_FRAMEWORK // SYSTEMD: ACTIVE // CHROME: UNCONFINED</span
        >
      </div>
    </div>
  </div>
</section>

<style>
  .routing-showcase {
    padding: 72px 0 96px;
  }

  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--crimson-light);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }
  .tag-accent {
    color: var(--text-dim);
  }

  .section-heading-group {
    margin-bottom: 48px;
  }
  .section-heading-group h2 {
    font-size: 2.5rem;
    letter-spacing: -0.03em;
    margin-bottom: 12px;
  }
  .section-heading-group p {
    color: var(--text-muted);
    font-size: 1.1rem;
    max-width: 680px;
  }

  .routing-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .split-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all 0.25s ease;
  }
  .split-card:hover {
    border-color: var(--border-card);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.8);
  }
  .split-card.container-mode:hover {
    border-color: var(--border-crimson);
  }
  .split-card.vm-mode:hover {
    border-color: var(--border-amber);
  }

  .card-top-bar {
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mode-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mode-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }
  .mode-badge.docker {
    background: var(--crimson-dim);
    border: 1px solid var(--border-crimson);
    color: var(--crimson-light);
  }
  .mode-badge.vm {
    background: var(--solar-dim);
    border: 1px solid var(--border-amber);
    color: var(--solar-light);
  }

  .mode-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .mode-metrics {
    display: flex;
    gap: 6px;
  }
  .metric-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-muted);
  }
  .metric-pill.crimson {
    color: var(--crimson-light);
    background: var(--crimson-dim);
  }
  .metric-pill.solar {
    color: var(--solar-light);
    background: var(--solar-dim);
  }

  .code-editor-box {
    display: flex;
    padding: 20px;
    background: #070910;
    overflow-x: auto;
  }
  .editor-gutter {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.75;
    color: #262e40;
    padding-right: 14px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    margin-right: 14px;
    user-select: none;
  }
  .editor-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.75;
    color: #cbd5e1;
    flex: 1;
  }
  .editor-code .k {
    color: #ff5470;
  }
  .editor-code .v {
    color: #10b981;
  }

  .label-match {
    background: var(--crimson-dim);
    border: 1px solid var(--crimson);
    color: var(--crimson-light);
    padding: 1px 6px;
    border-radius: 2px;
    font-weight: 700;
  }
  .label-match.vm {
    background: var(--solar-dim);
    border-color: var(--solar);
    color: #fff;
  }

  .card-bottom-telemetry {
    padding: 8px 18px;
    background: rgba(0, 0, 0, 0.4);
    border-top: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-dim);
    letter-spacing: 0.06em;
  }

  @media (max-width: 860px) {
    .routing-split {
      grid-template-columns: 1fr;
    }
  }
</style>
